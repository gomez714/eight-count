generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  ADMIN
  INSTRUCTOR
  ASSISTANT
  DANCER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum VideoAssetStatus {
  UPLOADING
  READY
  FAILED
}

enum NoteStatus {
  OPEN
  IN_PROGRESS
  ADDRESSED
  RESOLVED
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  name        String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers              TeamMember[]
  createdProjects          Project[]               @relation("ProjectCreatedBy")
  createdRehearsals        Rehearsal[]             @relation("RehearsalCreatedBy")
  uploadedVideoAssets      VideoAsset[]
  notes                    Note[]                  @relation("NoteAuthor")
  noteAssignments          NoteAssignment[]        @relation("AssignedNoteUser")
  noteStatusUpdates        NoteAssignmentStatus[]  @relation("NoteStatusUpdatedBy")
}

model Team {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(DANCER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id              String        @id @default(cuid())
  teamId          String
  title           String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  rehearsals Rehearsal[]

  @@index([teamId])
  @@index([createdByUserId])
}

model Rehearsal {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String?
  rehearsalDate   DateTime
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("RehearsalCreatedBy", fields: [createdByUserId], references: [id])
  videoAsset VideoAsset?
  notes      Note[]

  @@index([projectId])
  @@index([createdByUserId])
  @@index([rehearsalDate])
}

model VideoAsset {
  id               String           @id @default(cuid())
  rehearsalId      String           @unique
  bucketName       String
  objectPath       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  durationMs       Int?
  uploadedByUserId String
  status           VideoAssetStatus @default(UPLOADING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal  Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedByUserId], references: [id])
  notes      Note[]

  @@index([uploadedByUserId])
  @@index([status])
}

model Note {
  id           String @id @default(cuid())
  rehearsalId  String
  videoAssetId String
  authorUserId String
  bodyText     String
  timestampMs  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal   Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  videoAsset  VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  author      User             @relation("NoteAuthor", fields: [authorUserId], references: [id])
  assignments NoteAssignment[]

  @@index([rehearsalId])
  @@index([videoAssetId])
  @@index([authorUserId])
  @@index([timestampMs])
}

model NoteAssignment {
  id        String @id @default(cuid())
  noteId     String
  userId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note      Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User                   @relation("AssignedNoteUser", fields: [userId], references: [id])
  status    NoteAssignmentStatus?

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

model NoteAssignmentStatus {
  id               String     @id @default(cuid())
  noteAssignmentId String     @unique
  status           NoteStatus @default(OPEN)
  updatedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteAssignment NoteAssignment @relation(fields: [noteAssignmentId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("NoteStatusUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([status])
}