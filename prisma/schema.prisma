generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  ADMIN
  INSTRUCTOR
  ASSISTANT
  DANCER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum VideoAssetStatus {
  UPLOADING
  READY
  FAILED
}

enum AudioAssetStatus {
  UPLOADING
  READY
  FAILED
}

enum NoteType {
  TEXT
  VOICE
}

enum NoteStatus {
  OPEN
  IN_PROGRESS
  ADDRESSED
  RESOLVED
}

enum NoteTargetKind {
  EVERYONE
  GROUP
  USER
}

enum NoteTag {
  TIMING
  SPACING
  ENERGY
  MUSICALITY
  FORMATION
  TECHNIQUE
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  name        String?
  imageUrl    String?

  /// Onboarding dismissal flags. Shape: `{ checklistDismissedAt?: ISO; tipsDismissed?: Record<string, ISO> }`.
  /// `null` = user hasn't dismissed anything yet → checklist + tips render.
  onboardingState Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers              TeamMember[]
  createdProjects          Project[]               @relation("ProjectCreatedBy")
  createdRehearsals        Rehearsal[]             @relation("RehearsalCreatedBy")
  uploadedVideoAssets      VideoAsset[]
  uploadedAudioAssets      AudioAsset[]
  notes                    Note[]                  @relation("NoteAuthor")
  noteAssignments          NoteAssignment[]        @relation("AssignedNoteUser")
  noteStatusUpdates        NoteAssignmentStatus[]  @relation("NoteStatusUpdatedBy")
  noteTargets              NoteTarget[]            @relation("NoteTargetUser")
  invitationsSent          TeamInvitation[]        @relation("InvitationInviter")
  invitationsAccepted      TeamInvitation[]        @relation("InvitationAcceptor")
}

model Team {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  projects    Project[]
  invitations TeamInvitation[]
}

model TeamInvitation {
  id               String               @id @default(cuid())
  teamId           String
  email            String
  role             TeamRole             @default(DANCER)
  tokenHash        String               @unique
  status           TeamInvitationStatus @default(PENDING)
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([teamId])
  @@index([email])
  @@index([status])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(DANCER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team             Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectGroupships ProjectGroupMember[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id              String        @id @default(cuid())
  teamId          String
  title           String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  rehearsals Rehearsal[]
  groups     ProjectGroup[]

  @@index([teamId])
  @@index([createdByUserId])
}

model ProjectGroup {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ProjectGroupMember[]
  noteTargets NoteTarget[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectGroupMember {
  id             String @id @default(cuid())
  projectGroupId String
  teamMemberId   String

  createdAt DateTime @default(now())

  group      ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
  teamMember TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([projectGroupId, teamMemberId])
  @@index([projectGroupId])
  @@index([teamMemberId])
}

model Rehearsal {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String?
  rehearsalDate   DateTime
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("RehearsalCreatedBy", fields: [createdByUserId], references: [id])
  videoAsset  VideoAsset?
  audioAssets AudioAsset[]
  notes       Note[]

  @@index([projectId])
  @@index([createdByUserId])
  @@index([rehearsalDate])
}

model VideoAsset {
  id               String           @id @default(cuid())
  rehearsalId      String           @unique
  bucketName       String
  objectPath       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  durationMs       Int?
  uploadedByUserId String
  status           VideoAssetStatus @default(UPLOADING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal  Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedByUserId], references: [id])
  notes      Note[]

  @@index([uploadedByUserId])
  @@index([status])
}

model AudioAsset {
  id               String           @id @default(cuid())
  rehearsalId      String
  bucketName       String
  objectPath       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  durationMs       Int?
  uploadedByUserId String
  status           AudioAssetStatus @default(UPLOADING)

  /// Transcription pipeline state. PENDING = row exists, transcription not yet
  /// kicked off (or never will be — e.g. legacy rows before backfill);
  /// PROCESSING = request in flight to Deepgram; READY = transcript populated;
  /// FAILED = error in transcriptError, retryable by staff.
  transcript       String?
  transcriptStatus TranscriptStatus @default(PENDING)
  transcriptError  String?
  transcribedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal  Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedByUserId], references: [id])
  note       Note?

  @@index([rehearsalId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([transcriptStatus])
}

model Note {
  id               String   @id @default(cuid())
  rehearsalId      String
  videoAssetId     String
  authorUserId     String
  noteType         NoteType @default(TEXT)
  bodyText         String?
  startTimestampMs Int
  endTimestampMs   Int?
  audioAssetId     String?  @unique
  tag              NoteTag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal   Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  videoAsset  VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  author      User             @relation("NoteAuthor", fields: [authorUserId], references: [id])
  audioAsset  AudioAsset?      @relation(fields: [audioAssetId], references: [id])
  assignments NoteAssignment[]
  targets     NoteTarget[]

  @@index([rehearsalId])
  @@index([videoAssetId])
  @@index([authorUserId])
  @@index([startTimestampMs])
  @@index([tag])
}

model NoteAssignment {
  id        String @id @default(cuid())
  noteId     String
  userId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note      Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User                   @relation("AssignedNoteUser", fields: [userId], references: [id])
  status    NoteAssignmentStatus?

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

model NoteAssignmentStatus {
  id               String     @id @default(cuid())
  noteAssignmentId String     @unique
  status           NoteStatus @default(OPEN)
  updatedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteAssignment NoteAssignment @relation(fields: [noteAssignmentId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("NoteStatusUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([status])
}

model NoteTarget {
  id             String         @id @default(cuid())
  noteId         String
  kind           NoteTargetKind
  userId         String?
  projectGroupId String?

  createdAt DateTime @default(now())

  note  Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user  User?         @relation("NoteTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  group ProjectGroup? @relation(fields: [projectGroupId], references: [id], onDelete: SetNull)

  @@index([noteId])
  @@index([userId])
  @@index([projectGroupId])
}