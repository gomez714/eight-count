generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  ADMIN
  INSTRUCTOR
  ASSISTANT
  DANCER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum VideoAssetStatus {
  UPLOADING
  READY
  FAILED
}

enum AudioAssetStatus {
  UPLOADING
  READY
  FAILED
}

enum NoteType {
  TEXT
  VOICE
}

enum NoteStatus {
  OPEN
  IN_PROGRESS
  ADDRESSED
  RESOLVED
}

enum NoteTargetKind {
  EVERYONE
  GROUP
  USER
}

enum NoteTag {
  TIMING
  SPACING
  ENERGY
  MUSICALITY
  FORMATION
  TECHNIQUE
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ReactionKind {
  ACKNOWLEDGE
  QUESTION
  ENCOURAGE
}

enum ResourceType {
  LINK
  // FILE reserved for v1.5 — uploaded files via a separate FileAsset table
  // sharing the AudioAsset two-step upload pattern (upload-url → GCS PUT → complete).
}

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  email       String  @unique
  name        String?
  imageUrl    String?

  /// Onboarding dismissal flags. Shape: `{ checklistDismissedAt?: ISO; tipsDismissed?: Record<string, ISO> }`.
  /// `null` = user hasn't dismissed anything yet → checklist + tips render.
  onboardingState Json?

  /// Soft-delete timestamp. When set, the user is treated as removed:
  /// excluded from active-user listings (team rosters, audience pickers,
  /// etc.) but their historical attribution (authored notes, etc.) stays
  /// intact. Reclaim happens automatically when someone signs up again
  /// with the same email — see `ensureDbUser`.
  deletedAt DateTime?

  /// Daily email digest opt-in. Defaults true for new accounts; the
  /// sign-up form discloses it, the invitation email mentions it, and
  /// every digest carries a one-click unsubscribe link that flips this
  /// to false. Users can also manage it at /settings/notifications.
  digestEnabled Boolean @default(true)

  /// Timestamp of the most recent digest email we sent the user. The
  /// cron uses this as the lower bound for "what's new since last
  /// digest" — first-time sends (null) include up to 7 days of activity.
  /// Also used by the cron's skip-if-recently-active heuristic.
  lastDigestSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers           TeamMember[]
  createdProjects       Project[]              @relation("ProjectCreatedBy")
  createdRehearsals     Rehearsal[]            @relation("RehearsalCreatedBy")
  uploadedVideoAssets   VideoAsset[]
  uploadedAudioAssets   AudioAsset[]
  notes                 Note[]                 @relation("NoteAuthor")
  noteAssignments       NoteAssignment[]       @relation("AssignedNoteUser")
  noteStatusUpdates     NoteAssignmentStatus[] @relation("NoteStatusUpdatedBy")
  noteTargets           NoteTarget[]           @relation("NoteTargetUser")
  invitationsSent       TeamInvitation[]       @relation("InvitationInviter")
  invitationsAccepted   TeamInvitation[]       @relation("InvitationAcceptor")
  noteComments          NoteComment[]          @relation("NoteCommentAuthor")
  noteReactions         NoteReaction[]         @relation("NoteReactionUser")
  noteThreadViews       NoteThreadView[]       @relation("NoteThreadViewUser")
  discussions           Discussion[]           @relation("DiscussionAuthor")
  discussionComments    DiscussionComment[]    @relation("DiscussionCommentAuthor")
  discussionReactions   DiscussionReaction[]   @relation("DiscussionReactionUser")
  discussionThreadViews DiscussionThreadView[] @relation("DiscussionThreadViewUser")
  createdResources      ProjectResource[]      @relation("ProjectResourceCreatedBy")
}

model Team {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  projects    Project[]
  invitations TeamInvitation[]
}

model TeamInvitation {
  id               String               @id @default(cuid())
  teamId           String
  email            String
  role             TeamRole             @default(DANCER)
  tokenHash        String               @unique
  status           TeamInvitationStatus @default(PENDING)
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([teamId])
  @@index([email])
  @@index([status])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(DANCER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team              Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectGroupships ProjectGroupMember[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id              String        @id @default(cuid())
  teamId          String
  title           String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  rehearsals  Rehearsal[]
  groups      ProjectGroup[]
  discussions Discussion[]
  resources   ProjectResource[]

  @@index([teamId])
  @@index([createdByUserId])
}

model ProjectGroup {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ProjectGroupMember[]
  noteTargets NoteTarget[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectGroupMember {
  id             String @id @default(cuid())
  projectGroupId String
  teamMemberId   String

  createdAt DateTime @default(now())

  group      ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
  teamMember TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([projectGroupId, teamMemberId])
  @@index([projectGroupId])
  @@index([teamMemberId])
}

/// A reference artifact attached to a project — production documents,
/// running orders, choreographic references, shared spreadsheets, etc.
/// V1 stores titled external URLs (`resourceType = LINK`); v1.5 will add
/// `FILE` for uploaded assets via a separate FileAsset table.
///
/// `rehearsalId` is reserved for the v1.5 "anchor a resource to a specific
/// rehearsal" UI — nullable so today's project-level resources don't need
/// it set. Cascade behavior differs from Discussion intentionally: when a
/// rehearsal is deleted, the resource demotes to project-level (SetNull)
/// rather than being deleted. Reference material outlives the anchor;
/// a creative discussion does not.
///
/// Length limits (title 120, url 2048, description 280) are enforced at
/// the validation layer (`lib/resources/validation.ts`) — matches the
/// existing convention where Project.title, Note.bodyText, etc. are
/// unbounded at the DB level.
model ProjectResource {
  id              String       @id @default(cuid())
  projectId       String
  rehearsalId     String?
  createdByUserId String
  resourceType    ResourceType @default(LINK)
  title           String
  url             String
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rehearsal Rehearsal? @relation(fields: [rehearsalId], references: [id], onDelete: SetNull)
  createdBy User       @relation("ProjectResourceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, createdAt])
  @@index([rehearsalId])
  @@index([createdByUserId])
}

model Rehearsal {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String?
  rehearsalDate   DateTime
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("RehearsalCreatedBy", fields: [createdByUserId], references: [id])
  videoAsset  VideoAsset?
  audioAssets AudioAsset[]
  notes       Note[]
  discussions Discussion[]
  resources   ProjectResource[]

  @@index([projectId])
  @@index([createdByUserId])
  @@index([rehearsalDate])
}

model VideoAsset {
  id               String           @id @default(cuid())
  rehearsalId      String           @unique
  bucketName       String
  objectPath       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  durationMs       Int?
  uploadedByUserId String
  status           VideoAssetStatus @default(UPLOADING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal   Rehearsal    @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation(fields: [uploadedByUserId], references: [id])
  notes       Note[]
  discussions Discussion[]

  @@index([uploadedByUserId])
  @@index([status])
}

model AudioAsset {
  id               String           @id @default(cuid())
  rehearsalId      String
  bucketName       String
  objectPath       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  durationMs       Int?
  uploadedByUserId String
  status           AudioAssetStatus @default(UPLOADING)

  /// Transcription pipeline state. PENDING = row exists, transcription not yet
  /// kicked off (or never will be — e.g. legacy rows before backfill);
  /// PROCESSING = request in flight to Deepgram; READY = transcript populated;
  /// FAILED = error in transcriptError, retryable by staff.
  transcript       String?
  transcriptStatus TranscriptStatus @default(PENDING)
  transcriptError  String?
  transcribedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal  Rehearsal   @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedByUserId], references: [id])
  note       Note?
  discussion Discussion?

  @@index([rehearsalId])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([transcriptStatus])
}

model Note {
  id               String   @id @default(cuid())
  rehearsalId      String
  videoAssetId     String
  authorUserId     String
  noteType         NoteType @default(TEXT)
  bodyText         String?
  startTimestampMs Int
  endTimestampMs   Int?
  audioAssetId     String?  @unique
  tag              NoteTag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rehearsal   Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  videoAsset  VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  author      User             @relation("NoteAuthor", fields: [authorUserId], references: [id])
  audioAsset  AudioAsset?      @relation(fields: [audioAssetId], references: [id])
  assignments NoteAssignment[]
  targets     NoteTarget[]
  comments    NoteComment[]
  reactions   NoteReaction[]
  threadViews NoteThreadView[]

  @@index([rehearsalId])
  @@index([videoAssetId])
  @@index([authorUserId])
  @@index([startTimestampMs])
  @@index([tag])
}

model NoteAssignment {
  id     String @id @default(cuid())
  noteId String
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note   Note                  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User                  @relation("AssignedNoteUser", fields: [userId], references: [id])
  status NoteAssignmentStatus?

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

model NoteAssignmentStatus {
  id               String     @id @default(cuid())
  noteAssignmentId String     @unique
  status           NoteStatus @default(OPEN)
  updatedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteAssignment NoteAssignment @relation(fields: [noteAssignmentId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("NoteStatusUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([status])
}

model NoteTarget {
  id             String         @id @default(cuid())
  noteId         String
  kind           NoteTargetKind
  userId         String?
  projectGroupId String?

  createdAt DateTime @default(now())

  note  Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user  User?         @relation("NoteTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  group ProjectGroup? @relation(fields: [projectGroupId], references: [id], onDelete: SetNull)

  @@index([noteId])
  @@index([userId])
  @@index([projectGroupId])
}

/// A reply on a note's thread. Flat (no nesting). Text-only in v1 —
/// voice replies are deferred. `deletedAt` is a soft-delete tombstone:
/// the row remains so thread continuity is preserved and the deleted
/// author/timestamp can still render as "Comment deleted".
model NoteComment {
  id        String    @id @default(cuid())
  noteId    String
  authorId  String
  bodyText  String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User @relation("NoteCommentAuthor", fields: [authorId], references: [id])

  @@index([noteId, createdAt])
  @@index([authorId])
}

/// One row per (note, user, kind) — the unique constraint enforces
/// "one reaction per user per kind per note". Click-again-to-remove
/// is implemented by deleting the row.
model NoteReaction {
  id        String       @id @default(cuid())
  noteId    String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation("NoteReactionUser", fields: [userId], references: [id])

  @@unique([noteId, userId, kind])
  @@index([noteId])
}

/// Per-(note, user) last-viewed timestamp powering the dashboard
/// unread-comment count. Upserted on thread expand. Author and all
/// assignees are tracked uniformly — see "Note threads" in CLAUDE.md.
model NoteThreadView {
  noteId       String
  userId       String
  lastViewedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation("NoteThreadViewUser", fields: [userId], references: [id])

  @@id([noteId, userId])
  @@index([userId])
}

/// A creative/process discussion — broader than an actionable Note.
/// Author + thread, no assignment, no status, no follow-through. Lives
/// at the project level always; optionally anchored to a rehearsal,
/// and optionally to a moment (or range) on that rehearsal's video.
/// See "Discussions" in CLAUDE.md for scope, anchoring rules, and the
/// shared thread architecture (parameterized over `ThreadTarget`).
///
/// Schema permits more combinations than the API allows. Validation
/// rules enforced in the create/update routes:
///   - rehearsalId, when set, must belong to projectId
///   - videoAssetId, when set, must reference the rehearsal's video AND rehearsalId must be set
///   - timestamps may only be non-null when videoAssetId is set
///   - voice (noteType=VOICE) requires rehearsalId, videoAssetId, and both timestamps
///     (project-level voice is deliberately not supported in v1 — AudioAsset.rehearsalId is required)
model Discussion {
  id               String   @id @default(cuid())
  projectId        String
  rehearsalId      String?
  videoAssetId     String?
  authorUserId     String
  /// Reuses the NoteType enum — TEXT or VOICE. The literal values apply
  /// equally to both objects today; if notes ever add a third type that
  /// doesn't fit discussions, fork the enum then.
  noteType         NoteType @default(TEXT)
  bodyText         String?
  /// Independently nullable from `endTimestampMs` so unanchored,
  /// single-timestamp, and range modes are all expressible. v1 UI ships
  /// unanchored + single-timestamp only; range support is deferred to v1.5.
  startTimestampMs Int?
  endTimestampMs   Int?
  audioAssetId     String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rehearsal   Rehearsal?             @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  videoAsset  VideoAsset?            @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  author      User                   @relation("DiscussionAuthor", fields: [authorUserId], references: [id])
  audioAsset  AudioAsset?            @relation(fields: [audioAssetId], references: [id])
  comments    DiscussionComment[]
  reactions   DiscussionReaction[]
  threadViews DiscussionThreadView[]

  @@index([projectId])
  @@index([rehearsalId])
  @@index([authorUserId])
  @@index([startTimestampMs])
}

/// A reply on a discussion's thread. Mirrors NoteComment exactly —
/// flat (no nesting), text-only in v1, soft-delete via `deletedAt`,
/// edited indicator via `editedAt`.
model DiscussionComment {
  id           String    @id @default(cuid())
  discussionId String
  authorId     String
  bodyText     String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User       @relation("DiscussionCommentAuthor", fields: [authorId], references: [id])

  @@index([discussionId, createdAt])
  @@index([authorId])
}

/// One row per (discussion, user, kind). Same toggle semantics as
/// NoteReaction — click-again-to-remove deletes the row.
model DiscussionReaction {
  id           String       @id @default(cuid())
  discussionId String
  userId       String
  kind         ReactionKind
  createdAt    DateTime     @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation("DiscussionReactionUser", fields: [userId], references: [id])

  @@unique([discussionId, userId, kind])
  @@index([discussionId])
}

/// Per-(discussion, user) last-viewed timestamp. Same shape as
/// NoteThreadView — composite PK, upserted on thread expand.
model DiscussionThreadView {
  discussionId String
  userId       String
  lastViewedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation("DiscussionThreadViewUser", fields: [userId], references: [id])

  @@id([discussionId, userId])
  @@index([userId])
}
